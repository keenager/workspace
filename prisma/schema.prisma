// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


// =====================
// 사용자
// =====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt 해시
  createdAt DateTime @default(now())

  // 내가 요청한 일정들
  requestedEvents EventRequest[] @relation("RequestedBy")
  // 나에게 할당된 일정들
  assignedEvents  EventAssignee[]
  // 사건 메모
  // cases  Case[]
}

// =====================
// 일정 관리
// =====================

// 일정 본체
model CalendarEvent {
  id          String      @id @default(cuid())
  title       String
  description String?
  allDay      Boolean
  startDate   DateTime
  endDate     DateTime
  priority    Priority    @default(NORMAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 요청 정보 (누가 만든 요청인지)
  request     EventRequest?
  // 첨부파일 (나중에 대비)
  attachments Attachment[]
}

// 요청 정보 (누가 만들었는지 + 전체 상태)
model EventRequest {
  id          String       @id @default(cuid())
  eventId     String       @unique
  event       CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User       @relation("RequestedBy", fields: [requestedById], references: [id])
  createdAt   DateTime     @default(now())

  // 담당자별 수락/거절 상태
  assignees   EventAssignee[]
}

// 담당자별 개별 상태 (핵심)
model EventAssignee {
  id        String      @id @default(cuid())
  requestId String
  request   EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    EventStatus @default(PENDING)
  respondedAt DateTime?  // 수락/거절한 시각
  comment   String?      // 거절 사유 등

  @@unique([requestId, userId]) // 같은 요청에 같은 사람 중복 방지
}

// 첨부파일 (나중에 대비해서 구조만)
model Attachment {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  url     String
}

enum EventStatus {
  PENDING    // 대기 중
  CONFIRMED  // 수락
  REJECTED   // 거절
  DONE       // 완료
}

enum Priority {
  URGENT
  NORMAL
  LOW
}


// =====================
// 사건 메모
// =====================

enum CaseType {
  CIVIL
  CRIMINAL
}

enum MandatoryDefenseReason {
  DETAINED  // 구속
  MINOR     // 미성년
  ELDERLY   // 70세 이상
  POVERTY   // 빈곤
  MENTAL    // 지능
}

// 공통 사건 정보
model Case {
  id          String    @id @default(cuid())
  caseNumber  String
  caseType    CaseType
  caseName    String
  court       String
  filedAt     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // createdById String
  // createdBy   User      @relation(fields: [createdById], references: [id])

  criminalCase  CriminalCase?

  // 메모 섹션
  sections CaseSection[]
}

// 형사 전용
model CriminalCase {
  id                     String  @id @default(cuid())
  caseId                 String  @unique
  case                   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  // 형사 당사자
  prosecutors            String

  criminalDefendants     CriminalDefendant[]
  compensationApplicants CompensationApplicant[]
  trials                 Trial[]
}


// 피고인
model CriminalDefendant {
  id                String        @id @default(cuid())
  criminalCaseId    String
  criminalCase      CriminalCase  @relation(fields: [criminalCaseId], references: [id], onDelete: Cascade)
  name              String
  birthDate         DateTime
  address           String
  order             Int
  crimeTitle        String

  // 구속 관련
  isDetained     Boolean   @default(false)
  detentionPlace String?
  detentionDate  DateTime?
  arrestDate     DateTime?

  // 변호인 관련
  isMandatoryPublicDefense Boolean                 @default(false)
  mandatoryReason          MandatoryDefenseReason?
  publicDefender  String?
  privateDefender String?

  // 공판기일 출석 관련
  trialAttendances     TrialAttendance[]

  createdAt DateTime @default(now())
}

// 배상신청인
model CompensationApplicant {
  id              String        @id @default(cuid())
  criminalCaseId  String
  criminalCase    CriminalCase  @relation(fields: [criminalCaseId], references: [id], onDelete: Cascade)
  name            String
  birthDate       DateTime
  address         String
  claimAmount     Int
  claimReason     String
  order           Int
  createdAt       DateTime      @default(now())
}


enum SectionType {
  EDITOR
  TRIAL
}

// 메모 섹션
model CaseSection {
  id          String      @id @default(cuid())
  caseId      String
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  content     String      @default("")
  order       Int
  sectionType SectionType @default(EDITOR)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 공판기일
model Trial {
  id             String       @id @default(cuid())
  criminalCaseId String
  criminalCase   CriminalCase @relation(fields: [criminalCaseId], references: [id], onDelete: Cascade)
  date           DateTime
  order          Int          // 1기일, 2기일...

  checkItems   String?  // 체크사항 (지난 기일 예정사항)
  proceedings  String?  // 진행사항
  submissions  String?  // 제출자료 및 신청사항

  attendances TrialAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrialAttendance {
  id              String   @id @default(cuid())
  trialId         String
  trial           Trial    @relation(fields: [trialId], references: [id], onDelete: Cascade)
  defendantId     String
  defendant       CriminalDefendant @relation(fields: [defendantId], references: [id], onDelete: Cascade)
  isPresent       Boolean  @default(true)
  isSummonsServed Boolean? // 불출석 시에만 의미 있음

  @@unique([trialId, defendantId])
}